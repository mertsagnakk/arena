<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <!-- ÜST PANEL (Skorlar) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.card.MaterialCardView android:layout_width="54dp" android:layout_height="54dp" app:cardCornerRadius="27dp" app:cardBackgroundColor="#4F46E5" app:strokeWidth="0dp">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="M" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/tvPlayer1Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Mert" android:textColor="#1E293B" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvPlayer1Score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#10B981" android:textSize="36sp" android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardTimer" android:layout_width="70dp" android:layout_height="70dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="35dp" app:strokeColor="#10B981" app:strokeWidth="3dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
            <TextView android:id="@+id/tvTimer" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="12" android:textColor="#10B981" android:textSize="28sp" android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.card.MaterialCardView android:layout_width="54dp" android:layout_height="54dp" app:cardCornerRadius="27dp" app:cardBackgroundColor="#94A3B8" app:strokeWidth="0dp">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="R" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/tvPlayer2Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Rakip" android:textColor="#64748B" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvPlayer2Score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#EF4444" android:textSize="36sp" android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SORU KARTI (Soru Sayacı Eklendi) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQuestion"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="24dp"
        app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/topPanel">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

            <TextView android:id="@+id/tvQuestionCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Soru 1/10" android:textColor="#64748B" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/tvQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Işığın boşluktaki yayılma hızı saniyede yaklaşık kaç kilometredir?" android:textColor="#1E293B" android:textSize="18sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ŞIKLAR BÖLÜMÜ (Aynı kaldı, kod kalabalığı yapmasın diye içeriğini sildim, kendi eski dosyandaki şıkları aynen buraya yapıştır veya alttaki full koddaki gibi bırak) -->
    <LinearLayout android:id="@+id/optionsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:layout_marginTop="20dp" android:orientation="vertical" app:layout_constraintTop_toBottomOf="@id/cardQuestion">

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardOptionA" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeColor="#E2E8F0" app:strokeWidth="2dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <View android:id="@+id/bgSplitA" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
                <com.google.android.material.card.MaterialCardView android:id="@+id/avatarP1A" android:layout_width="36dp" android:layout_height="36dp" android:layout_centerVertical="true" android:layout_alignParentStart="true" android:layout_marginStart="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#4F46E5" app:strokeWidth="0dp" android:visibility="invisible">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="M" android:textColor="#FFF" android:gravity="center" android:textStyle="bold"/>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/tvOptionA" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="A)  150.000 km/s" android:textColor="#334155" android:textSize="16sp" android:textStyle="bold" android:layout_toEndOf="@id/avatarP1A" android:layout_toStartOf="@+id/avatarP2A"/>
                <com.google.android.material.card.MaterialCardView android:id="@+id/avatarP2A" android:layout_width="36dp" android:layout_height="36dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" android:layout_marginEnd="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#94A3B8" app:strokeWidth="0dp" android:visibility="invisible">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="R" android:textColor="#FFF" android:gravity="center" android:textStyle="bold"/>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardOptionB" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeColor="#E2E8F0" app:strokeWidth="2dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <View android:id="@+id/bgSplitB" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
                <com.google.android.material.card.MaterialCardView android:id="@+id/avatarP1B" android:layout_width="36dp" android:layout_height="36dp" android:layout_centerVertical="true" android:layout_alignParentStart="true" android:layout_marginStart="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#4F46E5" app:strokeWidth="0dp" android:visibility="invisible">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="M" android:textColor="#FFF" android:gravity="center" android:textStyle="bold"/>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/tvOptionB" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="B)  220.000 km/s" android:textColor="#334155" android:textSize="16sp" android:textStyle="bold" android:layout_toEndOf="@id/avatarP1B" android:layout_toStartOf="@+id/avatarP2B"/>
                <com.google.android.material.card.MaterialCardView android:id="@+id/avatarP2B" android:layout_width="36dp" android:layout_height="36dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" android:layout_marginEnd="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#94A3B8" app:strokeWidth="0dp" android:visibility="invisible">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="R" android:textColor="#FFF" android:gravity="center" android:textStyle="bold"/>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardOptionC" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeColor="#E2E8F0" app:strokeWidth="2dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <View android:id="@+id/bgSplitC" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
                <com.google.android.material.card.MaterialCardView android:id="@+id/avatarP1C" android:layout_width="36dp" android:layout_height="36dp" android:layout_centerVertical="true" android:layout_alignParentStart="true" android:layout_marginStart="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#4F46E5" app:strokeWidth="0dp" android:visibility="invisible">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="M" android:textColor="#FFF" android:gravity="center" android:textStyle="bold"/>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/tvOptionC" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="C)  300.000 km/s" android:textColor="#334155" android:textSize="16sp" android:textStyle="bold" android:layout_toEndOf="@id/avatarP1C" android:layout_toStartOf="@+id/avatarP2C"/>
                <com.google.android.material.card.MaterialCardView android:id="@+id/avatarP2C" android:layout_width="36dp" android:layout_height="36dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" android:layout_marginEnd="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#94A3B8" app:strokeWidth="0dp" android:visibility="invisible">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="R" android:textColor="#FFF" android:gravity="center" android:textStyle="bold"/>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardOptionD" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginBottom="12dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:strokeColor="#E2E8F0" app:strokeWidth="2dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <View android:id="@+id/bgSplitD" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
                <com.google.android.material.card.MaterialCardView android:id="@+id/avatarP1D" android:layout_width="36dp" android:layout_height="36dp" android:layout_centerVertical="true" android:layout_alignParentStart="true" android:layout_marginStart="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#4F46E5" app:strokeWidth="0dp" android:visibility="invisible">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="M" android:textColor="#FFF" android:gravity="center" android:textStyle="bold"/>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/tvOptionD" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="D)  380.000 km/s" android:textColor="#334155" android:textSize="16sp" android:textStyle="bold" android:layout_toEndOf="@id/avatarP1D" android:layout_toStartOf="@+id/avatarP2D"/>
                <com.google.android.material.card.MaterialCardView android:id="@+id/avatarP2D" android:layout_width="36dp" android:layout_height="36dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" android:layout_marginEnd="12dp" app:cardCornerRadius="18dp" app:cardBackgroundColor="#94A3B8" app:strokeWidth="0dp" android:visibility="invisible">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="R" android:textColor="#FFF" android:gravity="center" android:textStyle="bold"/>
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- BUĞULU EŞLEŞME EKRANI -->
    <RelativeLayout android:id="@+id/overlayMatchmaking" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FF0B1120" android:elevation="20dp" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_centerInParent="true" android:gravity="center">
            <TextView android:id="@+id/tvOverlayStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rakip Aranıyor..." android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:layout_marginBottom="24dp"/>
            <ProgressBar android:id="@+id/overlaySpinner" android:layout_width="48dp" android:layout_height="48dp" android:indeterminateTint="#4F46E5"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/overlayTimerCard" android:layout_width="100dp" android:layout_height="100dp" app:cardCornerRadius="50dp" app:cardBackgroundColor="#1E293B" app:strokeColor="#4F46E5" app:strokeWidth="4dp" android:visibility="gone">
                <TextView android:id="@+id/tvOverlayTimer" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="3" android:textColor="#FFFFFF" android:textSize="48sp" android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </RelativeLayout>

    <!-- MAÇ SONUCU EKRANI (Başlangıçta Gizli) -->
    <RelativeLayout android:id="@+id/overlayMatchResult" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#EA0B1120" android:elevation="30dp" android:clickable="true" android:focusable="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_centerInParent="true" android:gravity="center" android:padding="24dp">

            <TextView android:id="@+id/tvResultTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ZAFER!" android:textColor="#10B981" android:textSize="40sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <TextView android:id="@+id/tvResultWinnerText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kazanan: Mert" android:textColor="#FFFFFF" android:textSize="18sp" android:layout_marginBottom="32dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="40dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="32dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sen" android:textColor="#94A3B8" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvResultMyScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="80" android:textColor="#4F46E5" android:textSize="36sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginStart="32dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rakip" android:textColor="#94A3B8" android:textSize="14sp"/>
                    <TextView android:id="@+id/tvResultOpponentScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60" android:textColor="#EF4444" android:textSize="36sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnReturnHome"
                android:layout_width="match_parent" android:layout_height="64dp"
                app:cardBackgroundColor="#EA580C" app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Ana Menüye Dön" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>